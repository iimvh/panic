<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.panic</groupId>
		<artifactId>panic-parent</artifactId>
		<version>1.0.0</version>
	</parent>
	<artifactId>panic-app</artifactId>
	<name>panic-app</name>
	<description>Spring Boot entry point (REST + static UI)</description>

	<dependencies>
		<dependency>
			<groupId>com.panic</groupId>
			<artifactId>panic-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Agent modules: adding a dependency is how you install an agent. -->
		<dependency>
			<groupId>com.panic</groupId>
			<artifactId>panic-agents-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.panic</groupId>
			<artifactId>panic-agent-example</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.panic</groupId>
			<artifactId>panic-agent-digest</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.panic.PanicApplication</mainClass>
					<!-- Overrides the parent's skip=true: only this module actually runs. -->
					<skip>false</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
