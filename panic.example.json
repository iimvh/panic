{
  "openrouter": { "apiKey": "${OPENROUTER_API_KEY}", "maxRetries": 2 },
  "mistral": { "apiKey": "${MISTRAL_API_KEY}" },
  "llm": {
    "provider": "openrouter",
    "model": "meta-llama/llama-3.3-70b-instruct:free",
    "temperature": 0.2,
    "maxTokens": 4096
  },
  "chat": {
    "systemPrompt": "You are Panic, a concise and helpful assistant.",
    "maxHistory": 40,
    "tools": true,
    "maxSteps": 25,
    "maxTokens": 400000,
    "toolTimeoutSeconds": 60,
    "contextTokens": 32000,
    "compact": true,
    "clearToolResultsAt": 16000,
    "keepToolResults": 3,
    "maxReviews": 1,
    "parallelTools": 1
  },
  "conversations": { "dir": ".panic/conversations", "persist": true },
  "todo": { "dir": ".panic/todo", "maxItems": 50 },
  "planner": { "byDefault": false, "allow": [], "approveTimeoutSeconds": 900, "dir": ".panic/plans", "root": "." },
  "shell": { "dir": ".", "timeoutSeconds": 120, "maxTimeoutSeconds": 600, "maxOutput": 8000, "maxBackground": 4 },
  "ask-user": { "timeoutSeconds": 900, "maxQuestions": 4, "maxOptions": 6 },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "command": "npx",
        "args": ["-y", "chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:9222"],
        "risk": "network",
        "enabled": false
      }
    },
    "timeoutSeconds": 120
  },
  "workspace": { "dir": ".panic/workspace" },
  "folder-picker": { "enabled": true, "timeoutSeconds": 120 },
  "tracing": { "dir": ".panic/traces", "keepDays": 30, "maxTraces": 500 },
  "checks": {
    "dir": ".",
    "checks": { "test": { "command": ["./gradlew", "check", "-PskipUi"], "timeoutSeconds": 600 } }
  },
  "review": { "maxTokens": 512 },
  "agents": {
    "profiles": {
      "explore": {
        "description": "Searches the codebase broadly (many files or folders) and reports each finding with its path, line numbers and the relevant code quoted, so you need not read those files again. Read-only. Not for reading one file you know.",
        "tools": ["read_file", "list_dir"],
        "maxSteps": 12
      }
    },
    "general": true,
    "maxDepth": 1,
    "maxParallel": 4,
    "timeoutSeconds": 600
  },
  "files": { "root": ".", "maxBytes": 65536, "maxWriteBytes": 1048576 },
  "permissions": {
    "risks": { "read": "allow", "write": "ask", "exec": "ask", "network": "ask" },
    "tools": { "todo_write": "allow" },
    "askTimeoutSeconds": 120,
    "bypassPermissions": false,
    "rules": {
      "allow": ["exec(ls *)", "exec(npm run build)", "exec(npm test *)", "exec(git status)", "exec(git diff *)"],
      "ask": ["exec(git push *)"],
      "deny": ["exec(kill *)", "exec(pkill *)", "exec(killall *)"]
    }
  },
  "web": { "enabled": false, "host": "127.0.0.1", "port": 8080, "detachSeconds": 120 }
}
